server {
	listen 80;
	server_name anthony.jlnsoftworks.com;
	root /var/www/anthony-mosaic;        # e.g. /var/www/site
	index index.html;

	# Serve your viewer page (the HTML that includes OpenSeadragon)
	location = / {
		try_files $uri /index.html;
	}

	# DZI manifest files (small XML/JSON)
	location ~ \.(dzi|json)$ {
		add_header Cache-Control "public, max-age=86400";     # 1 day (safe to revalidate)
		add_header Access-Control-Allow-Origin "*" always;    # enable if you load the viewer from another origin
		try_files $uri =404;
	}

	# Tile folders generated by dzsave/sharp:
	#   e.g. /tiles/mosaic.dzi and /tiles/mosaic_files/…  (or a single .szi file)
	location /tiles/ {
		# Long cache for image tiles; they're content-hashed/stable
		expires 1y;
		add_header Cache-Control "public, max-age=31536000, immutable";
		try_files $uri =404;
	}

	# Single-file SZI (zipped DZI) — make sure correct content-type + ranges
	location ~ \.szi$ {
		types { application/zip szi; }   # redundant if set in http/types, but harmless
		gzip off;                                # important for ranged reads (esp. Firefox)
	    add_header Accept-Ranges bytes;          # nginx does this by default, but explicit is fine
	    add_header Cache-Control "public, max-age=31536000, immutable";
	    # If viewer is on another origin, also expose Content-Range:
	    add_header Access-Control-Allow-Origin "*" always;
	    add_header Access-Control-Expose-Headers "Content-Range" always;
	    try_files $uri =404;

	}

	# Image tiles (AVIF/WebP/JPEG/PNG) anywhere on the site
	location ~* \.(avif|webp|jpe?g|png)$ {
		expires 1y;
		add_header Cache-Control "public, max-age=31536000, immutable";
		try_files $uri =404;
	}

	# Optional: wide-open CORS for all /tiles/ requests (if your viewer runs on another domain)
	# Uncomment this block if needed.
	# location ^~ /tiles/ {
	# 	add_header Access-Control-Allow-Origin "*" always;
	# 	add_header Access-Control-Allow-Methods "GET, OPTIONS" always;
	# 	if ($request_method = OPTIONS) { return 204; }
	# 	expires 1y;
	# 	add_header Cache-Control "public, max-age=31536000, immutable";
	# 	try_files $uri =404;
	# }

	# Basic security headers (optional)
	add_header X-Content-Type-Options nosniff;
}

